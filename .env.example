# Copy to .env (scripts/setup.sh does this and generates the encryption key for you). NEVER commit .env.
N8N_ENCRYPTION_KEY=generated-by-setup
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_USER_FOLDER=./data
GENERIC_TIMEZONE=UTC
TZ=UTC
# Optional: create the owner login automatically (setup.sh writes only a password HASH)
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD=ChangeMe12345   (used once by setup.sh, never stored)
# --- Moving to a server later: switch from SQLite to Postgres, keep the SAME N8N_ENCRYPTION_KEY ---
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=...  DB_POSTGRESDB_DATABASE=n8n  DB_POSTGRESDB_USER=...  DB_POSTGRESDB_PASSWORD=...
